# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./gh_corps.db

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# App
APP_NAME=GH Diseños
COMPANY_NAME=GH Diseños
COMPANY_EMAIL=infoghdisenos@gmail.com
ADMIN_EMAIL=infoghdisenos@gmail.com
APP_URL=http://localhost:8000

# Pagination
ITEMS_PER_PAGE=10

# Email (Gmail SMTP)
# Habilitar con MAIL_ENABLED=true y rellenar credenciales
# (usa una "contraseña de aplicación" de Google, no la contraseña normal)
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM_NAME=GH Diseños
